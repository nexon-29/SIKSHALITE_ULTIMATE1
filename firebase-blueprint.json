  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User authentication session profile and role mapping."
    },
    "/institutions/{institutionId}": {
      "schema": { "$ref": "#/entities/Institution" },
      "description": "Institution branding, photos, and admin ownership."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Institution subjects and assigned teacher rosters."
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Teacher records with mobile number, photo, and subject assignments."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student records with unique IDs, linked mobile numbers, and enrolled subjects."
    },
    "/publicProfiles/{profileId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "PII-free member names and photos visible within an institution."
    },
    "/phoneLinks/{linkId}": {
      "schema": { "$ref": "#/entities/PhoneLink" },
      "description": "Mobile number lookup bridge for OTP and Google fallback role claiming."
    },
    "/topics/{topicId}": {
      "schema": { "$ref": "#/entities/Topic" },
      "description": "Subject topics with study material, reference pictures, quizzes, and assignments."
    },
    "/growthRecords/{recordId}": {
      "schema": { "$ref": "#/entities/GrowthRecord" },
      "description": "Student topic attempts, assignment submissions, grades, and growth metrics."
    }
  }
}
