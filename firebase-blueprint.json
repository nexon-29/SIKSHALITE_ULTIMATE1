{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user session profile mapping a Firebase UID to an institution role and member record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase Auth UID of the user."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "teacher", "student"],
          "maxLength": 20,
          "description": "Role within the institution."
        },
        "institutionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Linked institution ID."
        },
        "memberId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Linked teacher, student, or institution document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the user."
        },
        "phoneE164": {
          "type": "string",
          "maxLength": 24,
          "description": "Verified or registered mobile number in E.164 format."
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "Verified email if signed in with Google fallback."
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 250000,
          "description": "Compressed profile image data URL or HTTPS URL."
        },
        "uniqueCode": {
          "type": "string",
          "maxLength": 40,
          "description": "Unique Student ID or Institution Join Code."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "role", "institutionId", "memberId", "displayName", "createdAt", "updatedAt"]
    },
